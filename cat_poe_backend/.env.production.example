# Production template — copy to `.env.production`, fill secrets, never commit the copy.
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# `deploy.sh` copies `.env.production` → `.env` so `docker-compose.prod.yml` (env_file: .env) matches.
#
# --- Public API (deploy / mirror scripts, health echoes) ---
PUBLIC_API_BASE=https://poe.catcoin.in

# --- Core (required for non-development) ---
ENVIRONMENT=production
SECRET_KEY=
# Encrypts sensitive admin_config columns (bot tokens, X API keys, etc.) at rest.
# REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_CONFIG_SECRETS_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API docs (/docs, /redoc) — required when ENVIRONMENT is not development
DOCS_USER=admin
DOCS_PASSWORD=

# --- Postgres (docker-compose.prod.yml substitutes into DATABASE_URL for containers) ---
DB_USER=catpoe
DB_PASSWORD=
DB_NAME=catcoin_poe
# Optional: override full URL for host-side scripts only; leave unset in normal Docker prod.
# DATABASE_URL=postgresql+asyncpg://catpoe:YOUR_PASSWORD@localhost:5432/catcoin_poe

# --- Email ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Where client-side error reports are mailed. Optional — leave blank to log
# without sending. Wins over admin_config.error_report_email.
# ERROR_REPORT_EMAIL=

# --- First boot: create `root` when missing (no defaults in repo) ---
ROOT_BOOTSTRAP_PASSWORD=
ROOT_BOOTSTRAP_EMAIL=

# --- Admin config seed (run_all_migrations / apply_db_migrations.sh); optional ---
# ADMIN_CONFIG_ENV_FORCE=0

# --- Social / integrations (optional; often mirrored into admin_config) ---
X_COMMUNITY_USERNAME=
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_COMMUNITY_ID=

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE_LINK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_LINK=

# --- Mobile / integrity ---
PLAY_INTEGRITY_PROJECT_NUMBER=

# --- Auth rate limits (optional overrides) ---
# DISABLE_AUTH_RATE_LIMIT=0

# --- Logs / reload (compose also sets this for blue/green) ---
WATCHFILES_FORCE_POLLING=1
