# Copy to `.env` and fill in values. Never commit `.env` or `.env.production`.

# --- Deploy scripts (deploy.sh, mirror_deploy.sh) ---
# Public API origin with no trailing slash — health curl and summary output. Forks should set their own host.
# PUBLIC_API_BASE=https://poe.catcoin.in

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=

# Encrypts sensitive admin_config columns (bot tokens, X API keys, etc.) at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when ENVIRONMENT != development. In dev a stable key is derived from SECRET_KEY when blank.
ADMIN_CONFIG_SECRETS_KEY=

# JWT (defaults match config.Settings)
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Referral milestone bonus / reconciliation job ---
# When true, main.py starts an asyncio loop that runs reconciliation daily (dev-friendly).
# When false, disable here and run exactly one scheduled job elsewhere:
#   python -m jobs.referral_reconciliation
# PostgreSQL advisory locking still prevents overlapping runs across instances.
ENABLE_IN_PROCESS_REFERRAL_RECONCILIATION=true

# --- Stale signup cleanup (never verified email) ---
# Deletes unverified accounts with zero balance/earnings older than UNVERIFIED_USER_RETENTION_HOURS
# so those emails can register again. API runs this periodically unless disabled below.
UNVERIFIED_USER_RETENTION_HOURS=8
ENABLE_IN_PROCESS_UNVERIFIED_USER_CLEANUP=true
UNVERIFIED_CLEANUP_INTERVAL_SECONDS=3600
# Manual run: python -m jobs.unverified_user_cleanup

# --- Auth rate limits (in-process; set DISABLE_AUTH_RATE_LIMIT=1 for tests) ---
# DISABLE_AUTH_RATE_LIMIT=1
# AUTH_RL_SIGNUP_PER_HOUR_IP=20
# AUTH_RL_LOGIN_PER_MINUTE_IP=30
# AUTH_RL_FORGOT_PER_HOUR_IP=10
# AUTH_RL_FORGOT_PER_HOUR_EMAIL=5
# AUTH_RL_RESEND_PER_HOUR_IP=15
# AUTH_RL_RESEND_PER_HOUR_EMAIL=5
# AUTH_RL_VERIFY_PER_MINUTE_IP=30
# AUTH_RL_RESET_PER_MINUTE_IP=15
# Optional: full URL overrides DB_USER/DB_PASSWORD/DB_NAME when set
# DATABASE_URL=postgresql+asyncpg://catpoe:yourpassword@localhost:5432/catcoin_poe
DB_USER=catpoe
DB_PASSWORD=postgres
DB_NAME=catcoin_poe

# docker-compose.yml only: published host port for the API (container port stays 8000).
# Docker Desktop on Windows often fails binding 8000:8000 — default in compose is 18080.
# BACKEND_HOST_PORT=8000

# docker-compose backend only: set to 1 to run uvicorn with --reload. Default 0 avoids StatReload
# scanning the bind-mounted /app tree, which can crash with OSError: [Errno 5] Input/output error
# on some Docker Desktop / Windows / NFS setups. For hot reload, prefer: Postgres in Docker + uvicorn --reload on the host (README).
# ENABLE_UVICORN_RELOAD=1

# --- API docs (HTTP Basic for /docs and /redoc) ---
DOCS_USER=admin
DOCS_PASSWORD=

# --- Email ---
# Required when ENVIRONMENT is not development: signup/resend/forgot-password send real mail via SMTP.
# For local dev, leave SMTP_PASSWORD empty and keep ENVIRONMENT=development (codes are printed to the API log).
#
# Gmail / Google Workspace:
# - Use an App Password on the sending account (2FA required); normal passwords often fail.
# - SMTP_EMAIL must be that same mailbox address (From must match login).
# - Port 587 + STARTTLS (defaults below), or port 465 (implicit SSL — code uses SMTP_SSL when SMTP_PORT=465).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=noreply@example.com
SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_TIMEOUT_SECONDS=25

# Where client-side error reports get mailed (POST /v1/diagnostics/client-error).
# Wins over admin_config.error_report_email when both are set. Leave blank to
# accept reports without sending email (the endpoint still logs them).
# ERROR_REPORT_EMAIL=support@example.com

# --- First boot (no default credentials in repo) ---
# Used by create_root_user.py on startup when the `root` user is missing.
# ROOT_BOOTSTRAP_PASSWORD=
# ROOT_BOOTSTRAP_EMAIL=

# After deploy, seed_admin_config_from_env.py (via run_all_migrations / apply_db_migrations.sh)
# copies non-empty values below into admin_config when those DB columns are still empty.
# Set ADMIN_CONFIG_ENV_FORCE=1 to overwrite admin_config from env on every migration run.
# ADMIN_CONFIG_ENV_FORCE=0

# --- Social / integrations (optional; many are stored in DB admin_config) ---
X_COMMUNITY_USERNAME=
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_COMMUNITY_ID=

DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Discord / Telegram community integration
# Required only if you enable the related missions / verification flows.

DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID
DISCORD_INVITE_LINK=https://discord.gg/YOUR_INVITE_CODE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_CHANNEL_LINK=https://t.me/YOUR_TELEGRAM_CHANNEL

# --- One-off scripts ---
# update_x_community.py requires numeric X_COMMUNITY_ID (see above).
# test_endpoints.py: TEST_ADMIN_USER, TEST_ADMIN_PASSWORD (optional: TEST_API_BASE_URL).
# verify_deployment.py: TEST_USER, TEST_PASS (optional: API_URL).
# test_x_integration.py: optional X_TEST_OWNER_USERNAME (else uses placeholder YOUR_X_USERNAME).
# ANDROID_AD_UNIT_ID=ca-app-pub-xxxxxxxx/yyyyyyyy
# IOS_AD_UNIT_ID=ca-app-pub-xxxxxxxx/zzzzzzzz

# --- Mobile / integrity (backend verification) ---
PLAY_INTEGRITY_PROJECT_NUMBER=
